# GraphQL API Configuration
VITE_GRAPHQL_ENDPOINT=https://your-appsync-endpoint.appsync-api.region.amazonaws.com/graphql
VITE_GRAPHQL_WS_ENDPOINT=wss://your-appsync-endpoint.appsync-realtime-api.region.amazonaws.com/graphql
VITE_APPSYNC_API_KEY=your-api-key-here

# AWS Cognito Configuration
VITE_AWS_REGION=us-west-2
VITE_USER_POOL_ID=us-west-2_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_IDENTITY_POOL_ID=us-west-2:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Midway OIDC Configuration (Optional - for Amazon employee SSO)
VITE_MIDWAY_OIDC_ENABLED=false
VITE_MIDWAY_OIDC_DOMAIN=your-midway-domain.auth.us-west-2.amazoncognito.com
VITE_MIDWAY_OIDC_CLIENT_ID=your-midway-client-id

# Development Configuration
VITE_NODE_ENV=development
VITE_LOG_LEVEL=debug