{
  "environment": "dev",
  
  "aws": {
    "account": "",
    "region": "us-east-1"
  },
  
  "apiGateway": {
    "throttling": {
      "rateLimit": 10,
      "burstLimit": 20
    },
    "cors": {
      "allowOrigins": [
        "http://localhost:3000"
      ],
      "allowMethods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "allowHeaders": [
        "Content-Type",
        "Authorization"
      ]
    }
  },
  
  "database": {
    "type": "dynamodb",
    "billingMode": "PAY_PER_REQUEST",
    "pointInTimeRecovery": false
  },
  
  "tableNames": {
    "productTable": "ProductCatalog",
    "pricingTable": "PricingOrchestration"
  },
  
  "bedrock": {
    "region": "us-east-1",
    "models": {
      "classifier": "anthropic.claude-3-5-haiku-20241022-v1:0",
      "specialized": "us.anthropic.claude-sonnet-4-20250514-v1:0",
      "supervisor": "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
    }
  },
  
  "agentCore": {
    "region": "us-east-1",
    "codeBucket": "retail-pricing-agentcore-code",
    "note": "Actual bucket name will be: retail-pricing-agentcore-code-{ENVIRONMENT}-{ACCOUNT_ID}",
    "agents": {
      "demandForecast": "",
      "competitiveAnalysis": "",
      "marginAnalysis": ""
    }
  },
  
  "appSync": {
    "endpoint": "",
    "apiId": "",
    "wssEndpoint": "",
    "apiKey": ""
  },
  
  "cognito": {
    "poolId": "",
    "poolClientId": ""
  },
  
  "amplify": {
    "appId": "",
    "appName": "RetailPricingUI",
    "defaultDomain": "",
    "appUrl": "",
    "environment": "dev"
  },
  
  "monitoring": {
    "logLevel": "DEBUG",
    "metricsEnabled": false,
    "tracingEnabled": false
  },
  
  "sageMakerCanvas": {
    "note": "SageMaker Canvas infrastructure is mandatory and will always be deployed. Bucket base names will have -{ACCOUNT_ID} appended. Final names written after CDK deployment.",
    "domainNamePrefix": "pricing-canvas",
    "trainingDataBucketBase": "pricing-canvas-training-data",
    "trainingDataBucket": "",
    "modelOutputBucketBase": "pricing-canvas-model-outputs",
    "modelOutputBucket": "",
    "enableVpc": true,
    "vpcCidr": "10.2.0.0/16",
    "modelCategories": [
      "powertools",
      "kitchen",
      "apparel",
      "footwear"
    ],
    "trainingSchedule": {
      "enabled": false,
      "frequency": "weekly"
    },
    "performanceThresholds": {
      "minAccuracy": 0.7,
      "maxModelAge": 90
    },
    "autopilotExecutionRoleArn": ""
  }
}
