# AWS Configuration for CDK Deployment
# Copy this file to .env and update with your credentials

# Method 1: Temporary AWS Credentials (Recommended for temporary access)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here (if using temporary credentials)

# Method 2: AWS Profile (Recommended for permanent access)
# AWS_PROFILE=your_profile_name

# AWS Account and Region (Required)
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# Environment
ENVIRONMENT=dev

# Note: Configuration priority order:
# 1. CDK context parameters (--context account=xxx --context region=xxx)
# 2. JSON configuration files (config/dev.json, config/prod.json)  
# 3. Environment variables (CDK_DEFAULT_ACCOUNT, CDK_DEFAULT_REGION)
# 4. AWS CLI default profile

# Credential priority order:
# 1. Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN)
# 2. AWS_PROFILE environment variable
# 3. AWS CLI default profile